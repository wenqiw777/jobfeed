#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

args=(docker compose run --rm)
for file in config.toml resume.md preamble_personal.md; do
    if [ -f "$REPO_ROOT/$file" ]; then
        args+=(-v "$REPO_ROOT/$file:/app/$file:ro")
    fi
done

exec "${args[@]}" jobfeed-cli jobfeed "$@"
