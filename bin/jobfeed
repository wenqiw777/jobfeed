#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

fail() {
    printf 'error: %s\n' "$*" >&2
    exit 2
}

if [ "${1:-}" = "migrate" ] && [ "${2:-}" = "capture-postgres-baseline" ]; then
    shift 2
    dump_input=""
    artifact_input=""
    forwarded=(
        migrate capture-postgres-baseline
        --workload /app/docs/contracts/fixtures/sqlite-store-benchmark-v1.json
        --machine-token-env JOBFEED_BENCH_MACHINE_TOKEN
    )

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --source-dump)
                [ "$#" -ge 2 ] || fail "--source-dump requires a path"
                [ -z "$dump_input" ] || fail "--source-dump may be provided only once"
                dump_input="$2"
                shift 2
                ;;
            --source-dump=*)
                [ -z "$dump_input" ] || fail "--source-dump may be provided only once"
                dump_input="${1#*=}"
                shift
                ;;
            --artifact-dir)
                [ "$#" -ge 2 ] || fail "--artifact-dir requires a path"
                [ -z "$artifact_input" ] || fail "--artifact-dir may be provided only once"
                artifact_input="$2"
                shift 2
                ;;
            --artifact-dir=*)
                [ -z "$artifact_input" ] || fail "--artifact-dir may be provided only once"
                artifact_input="${1#*=}"
                shift
                ;;
            --machine-token-env)
                [ "$#" -ge 2 ] || fail "--machine-token-env requires a name"
                [ "$2" = "JOBFEED_BENCH_MACHINE_TOKEN" ] \
                    || fail "--machine-token-env must use JOBFEED_BENCH_MACHINE_TOKEN"
                shift 2
                ;;
            --machine-token-env=JOBFEED_BENCH_MACHINE_TOKEN)
                shift
                ;;
            --machine-token-env=*|--workload|--workload=*)
                fail "benchmark workload and machine token contract are fixed"
                ;;
            --source-restore-attestation|--source-restore-attestation=*|\
            --scratch-restore-attestation|--scratch-restore-attestation=*|\
            --dsn-env|--dsn-env=*|--scratch-dsn-env|--scratch-dsn-env=*)
                fail "user-provided DSNs and restore attestations are not accepted"
                ;;
            *)
                forwarded+=("$1")
                shift
                ;;
        esac
    done

    [ -n "$dump_input" ] || fail "--source-dump is required"
    [ -n "$artifact_input" ] || fail "--artifact-dir is required"
    [ ! -L "$dump_input" ] || fail "--source-dump must not be a symbolic link"
    [ -f "$dump_input" ] || fail "--source-dump must be an existing regular file"
    [ ! -e "$artifact_input" ] && [ ! -L "$artifact_input" ] \
        || fail "--artifact-dir must not already exist"

    dump_parent="$(CDPATH= cd -- "$(dirname -- "$dump_input")" && pwd -P)"
    dump_host="$dump_parent/$(basename -- "$dump_input")"
    artifact_parent_input="$(dirname -- "$artifact_input")"
    mkdir -p -- "$artifact_parent_input"
    artifact_parent="$(CDPATH= cd -- "$artifact_parent_input" && pwd -P)"
    artifact_name="$(basename -- "$artifact_input")"
    [ "$artifact_name" != "." ] && [ "$artifact_name" != ".." ] \
        || fail "--artifact-dir must name a new child directory"

    case "$dump_host" in
        "$artifact_parent"/*)
            fail "read-write artifact mount would expose source dump"
            ;;
    esac

    export JOBFEED_MIGRATION_DUMP_HOST="$dump_host"
    export JOBFEED_MIGRATION_ARTIFACT_PARENT_HOST="$artifact_parent"
    git_commit="$(git -C "$REPO_ROOT" rev-parse --verify HEAD^{commit})"
    [ "${#git_commit}" -eq 40 ] \
        || fail "repository HEAD must be an exact 40-character lowercase commit"
    case "$git_commit" in
        *[!0-9a-f]*)
            fail "repository HEAD must be an exact 40-character lowercase commit"
            ;;
    esac
    export JOBFEED_MIGRATION_GIT_COMMIT="$git_commit"
    migration_timeout="${JOBFEED_MIGRATION_TIMEOUT_SECONDS:-1800}"
    case "$migration_timeout" in
        ''|*[!0-9]*) fail "JOBFEED_MIGRATION_TIMEOUT_SECONDS must be an integer" ;;
    esac
    [ "$migration_timeout" -gt 0 ] \
        || fail "JOBFEED_MIGRATION_TIMEOUT_SECONDS must be positive"
    export JOBFEED_MIGRATION_TIMEOUT_SECONDS="$migration_timeout"
    run_host="$(mktemp -d "$artifact_parent/.jobfeed-migration-control.XXXXXX")"
    export JOBFEED_MIGRATION_RUN_HOST="$run_host"
    forwarded+=(
        --artifact-dir "/migration/artifacts/$artifact_name"
    )

    project_name="jobfeed-migration-${PPID}-$$-${RANDOM}"
    compose=(
        docker compose --file "$REPO_ROOT/docker-compose.yml"
        --project-directory "$REPO_ROOT"
        --project-name "$project_name"
        --profile migration
    )
    unset COMPOSE_FILE COMPOSE_PATH_SEPARATOR
    export JOBFEED_MIGRATION_PROJECT="$project_name"

    cleanup_migration_project() {
        status=$?
        trap - EXIT INT TERM HUP
        if ! "${compose[@]}" down --volumes --remove-orphans --timeout=30; then
            printf 'error: migration project cleanup failed\n' >&2
            printf 'Recovery: docker compose --project-directory %q --project-name %q --profile migration down --volumes --remove-orphans --timeout=30\n' \
                "$REPO_ROOT" "$project_name" >&2
            exit 70
        fi
        rm -rf -- "$run_host"
        exit "$status"
    }
    trap cleanup_migration_project EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP

    "${compose[@]}" up -d --wait --wait-timeout "$migration_timeout" \
        restore-source restore-scratch
    source_id="$("${compose[@]}" ps -q restore-source)"
    scratch_id="$("${compose[@]}" ps -q restore-scratch)"
    runner_name="${project_name}-migration-runner"
    runner_ref="$("${compose[@]}" run --build -d --no-deps --name "$runner_name" \
        migration-runner jobfeed migrate _capture-preprovisioned-baseline \
        "${forwarded[@]:2}")"
    runner_id="$(docker inspect --format '{{.Id}}' "$runner_ref")"
    network_name="${project_name}_migration-internal"

    write_inspection() {
        destination="$1"
        temporary="$destination.tmp"
        {
            printf '{"network":'
            docker network inspect --format '{{json .}}' "$network_name"
            printf ',"source":'
            docker inspect --format '{{json .}}' "$source_id"
            printf ',"scratch":'
            docker inspect --format '{{json .}}' "$scratch_id"
            printf ',"runner":'
            docker inspect --format '{{json .}}' "$runner_id"
            printf '}\n'
        } >"$temporary"
        chmod 0400 "$temporary"
        mv "$temporary" "$destination"
    }

    write_inspection "$run_host/pre-inspection.json"
    dump_sha="$(shasum -a 256 "$dump_host" | awk '{print $1}')"
    source_image="$(docker inspect --format '{{.Image}}' "$source_id")"
    scratch_image="$(docker inspect --format '{{.Image}}' "$scratch_id")"
    runner_image="$(docker inspect --format '{{.Image}}' "$runner_id")"
    bootstrap_tmp="$run_host/bootstrap.json.tmp"
    printf '{"bootstrap_version":1,"project_label":"%s","network":{"name":"%s","internal":true},"dump_mount":{"runner_path":"/run/jobfeed-migration/source.dump","read_only":true,"sha256":"%s"},"source":{"service":"restore-source","container_id":"%s","image_digest":"%s","project_label":"%s","network_name":"%s"},"scratch":{"service":"restore-scratch","container_id":"%s","image_digest":"%s","project_label":"%s","network_name":"%s"},"runner":{"service":"migration-runner","container_id":"%s","image_digest":"%s","project_label":"%s","network_name":"%s"}}\n' \
        "$project_name" "$network_name" "$dump_sha" \
        "$source_id" "$source_image" "$project_name" "$network_name" \
        "$scratch_id" "$scratch_image" "$project_name" "$network_name" \
        "$runner_id" "$runner_image" "$project_name" "$network_name" \
        >"$bootstrap_tmp"
    chmod 0400 "$bootstrap_tmp"
    mv "$bootstrap_tmp" "$run_host/bootstrap.json"

    deadline=$((SECONDS + migration_timeout))
    while [ "$SECONDS" -lt "$deadline" ]; do
        [ -f "$run_host/capture-ready.json" ] && break
        runner_running="$(docker inspect --format '{{.State.Running}}' "$runner_id")"
        if [ "$runner_running" != "true" ]; then
            runner_status="$(docker wait "$runner_id")"
            docker logs "$runner_id"
            fail "migration runner exited before capture-ready with $runner_status"
        fi
        sleep 0.25
    done
    [ -f "$run_host/capture-ready.json" ] || fail "migration runner capture timed out"
    write_inspection "$run_host/post-inspection.json"
    deadline=$((SECONDS + migration_timeout))
    while [ "$SECONDS" -lt "$deadline" ]; do
        runner_running="$(docker inspect --format '{{.State.Running}}' "$runner_id")"
        [ "$runner_running" = "true" ] || break
        sleep 0.25
    done
    [ "$runner_running" != "true" ] || fail "migration runner verification timed out"
    runner_status="$(docker wait "$runner_id")"
    docker logs "$runner_id"
    [ "$runner_status" = "0" ] || fail "migration runner failed with $runner_status"
    [ -f "$run_host/provenance-verified.json" ] \
        || fail "migration provenance verification marker missing"
    exit 0
fi

args=(docker compose run --rm)
if [ ! -t 0 ]; then
    args+=(-T)
fi
for file in config.toml resume.md preamble_personal.md; do
    if [ -f "$REPO_ROOT/$file" ]; then
        args+=(-v "$REPO_ROOT/$file:/app/$file:ro")
    fi
done

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/jobfeed"
mkdir -p "$CACHE_DIR"
args+=(-v "$CACHE_DIR:/root/.cache/jobfeed")

exec "${args[@]}" jobfeed-cli jobfeed "$@"
