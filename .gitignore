# Python bytecode and local test caches
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.hypothesis/
.tox/
.nox/
.pytype/
.pyre/
.dmypy.json
dmypy.json
.coverage
.coverage.*
coverage.xml
htmlcov/
test-results/
junit.xml

# Local environments and packaging output
.venv/
venv/
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Local runtime state for the Phase 0 walking skeleton
.jobfeed-dev/

# Web UI (the bare dist/ pattern above also matches web-ui/dist, but keep
# these explicit so scoping the Python patterns later can't expose them).
web-ui/node_modules/
web-ui/dist/

# Local editor and OS metadata
.DS_Store
.idea/
.vscode/
.claude/worktrees/

# Local/personal config (use config.example.toml as the template)
/config.toml

# Personal data — provide your own; never commit a real résumé / PII.
# The committed templates are resume.example.md / preamble_personal.example.md;
# your real files (copied from them) are resume.md / preamble_personal.md.
/resume.md
/preamble_personal.md
